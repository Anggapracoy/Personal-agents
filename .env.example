# Public installation values (set before building; never put secrets here).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid
# Optional App Store/TestFlight URL; defaults to the local waitlist.
NEXT_PUBLIC_IOS_DOWNLOAD_URL=
GOOGLE_SITE_VERIFICATION=

AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
DECISION_FEED_BUILD_ID=
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFIER_MODEL=claude-3-5-haiku-latest
ANTHROPIC_CARD_MODEL=claude-sonnet-5
ANTHROPIC_AGENT_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# Optional main-agent overrides; these take precedence over saved settings.
DASH_AGENT_PROVIDER=openai
DASH_AGENT_MODEL_ID=
# Legacy OpenAI-only override, used when DASH_AGENT_MODEL_ID is empty.
OPENAI_AGENT_MODEL=
PROACTIVE_MODEL_ID=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
GOOGLE_GENERATIVE_AI_API_KEY=
EXA_API_KEY=
OPENWEATHER_API_KEY=
BROWSERLESS_API_TOKEN=
BROWSERLESS_HOST=production-sfo.browserless.io
BROWSERLESS_SESSION_TIMEOUT_MS=1800000
BROWSERLESS_PROXY_COUNTRY=ca
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_TEMPLATE_ALIAS=decision-feed-agent
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 0 to route interactive starts through events instead of direct invoke.
INNGEST_FAST_INVOKE=1
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=com.example.dash
ENABLE_BACKGROUND_SCAN=false
ENABLE_GOOGLE_PUSH=false
GOOGLE_PUSH_BASE_URL=
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_WEBHOOK_SECRET=
GOOGLE_CALENDAR_WEBHOOK_SECRET=
GOOGLE_ROUTES_API_KEY=
PROACTIVE_SWEEP_ENABLED=true
PROACTIVE_TRAVEL_ENABLED=true
PROACTIVE_WEATHER_ENABLED=true
PROACTIVE_GOALS_ENABLED=true
DISCOVERY_HARNESS_ENABLED=true
DISCOVERY_LARGE_SCAN_THRESHOLD=50
DISCOVERY_MODEL_PROVIDER=openai
DISCOVERY_MODEL_ID=gpt-5.6-sol
DISCOVERY_MAX_CANDIDATES=40
CRON_SECRET=

# Optional latency diagnostics (operation names/durations only)
HARNESS_TIMING=0

# Optional server-only funded calling service. Existing Calling feature flag controls access.
RESIA_API_KEY=
RESIA_CALL_AGENT_ID=
# Optional production-only HTTPS callback, with a random token query parameter (at least 32 characters).
# Preview/local calling falls back to durable background polling. Never use the API key as the token.
RESIA_CALL_ENDED_WEBHOOK_URL=

# Main agent: Meta OpenAI-compatible API
META_API_KEY=

# Anakbuah WhatsApp Cloud API. Keep all values server-only.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0


# Optional Composio Platform project key; server-only. Never NEXT_PUBLIC.
COMPOSIO_API_KEY=


# Stable unique ID for this installation/environment. Never reuse between deployments.
# If omitted, a namespace is derived from AUTH_SECRET, origin and environment.
DASH_INSTALLATION_ID=
# Only set when your ingress overwrites this header on every request.
# Without it, non-Vercel waitlist requests share one conservative quota.
TRUSTED_CLIENT_IP_HEADER=

# Optional local Mac cookie import: disabled unless both are configured.
CHROME_PROFILE_IMPORT_LOCAL=0
CHROME_PROFILE_IMPORT_OWNER=
